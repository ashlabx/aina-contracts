{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aina:contract:DelegationGraph:1",
  "title": "DelegationGraph",
  "description": "Autonomous Coordination Layer contract. Explicit execution plan: task nodes, capability bindings, dependencies, and per-node retry and fallback policy.",
  "type": "object",
  "required": ["contract", "contract_version", "graph_id", "frame_ref", "nodes", "dependencies", "retry_policy", "fallback_policy"],
  "additionalProperties": true,
  "$defs": {
    "failure_kind": {"enum": ["timeout", "malformed", "empty", "error"]}
  },
  "properties": {
    "contract": {"const": "DelegationGraph"},
    "contract_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"},
    "graph_id": {"type": "string", "minLength": 8},
    "frame_ref": {"type": "string", "minLength": 1},
    "nodes": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["id", "task", "capability", "assigned_to", "op"], "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "task": {"enum": ["retrieve", "correlate", "synthesize"]},
          "capability": {"type": "string", "minLength": 1},
          "assigned_to": {"type": "string", "minLength": 1},
          "op": {"type": "string", "minLength": 1}
        }
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object", "required": ["from", "to"], "additionalProperties": false,
        "properties": {"from": {"type": "string"}, "to": {"type": "string"}}
      }
    },
    "retry_policy": {
      "type": "object",
      "additionalProperties": {
        "type": "object", "required": ["max_attempts", "backoff_ms", "retry_on"], "additionalProperties": false,
        "properties": {
          "max_attempts": {"type": "integer", "minimum": 1, "maximum": 10},
          "backoff_ms": {"type": "integer", "minimum": 0},
          "retry_on": {"type": "array", "items": {"$ref": "#/$defs/failure_kind"}}
        }
      }
    },
    "fallback_policy": {
      "type": "object",
      "additionalProperties": {
        "type": "object", "required": ["alternates", "on"], "additionalProperties": false,
        "properties": {
          "alternates": {"type": "array", "items": {"type": "object", "required": ["assigned_to", "op"], "additionalProperties": false,
                          "properties": {"assigned_to": {"type": "string"}, "op": {"type": "string"}}}},
          "on": {"type": "array", "items": {"$ref": "#/$defs/failure_kind"}}
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aina:contract:IntentFrame:1",
  "title": "IntentFrame",
  "description": "Semantic Intent Layer contract. Normalized, validated task intent. Produced only by the intent layer; immutable once released (a refinement is a new revision produced by the intent layer).",
  "type": "object",
  "required": ["contract", "contract_version", "frame_id", "revision", "goal", "entities", "constraints", "context_refs", "target_confidence"],
  "additionalProperties": true,
  "properties": {
    "contract": {"const": "IntentFrame"},
    "contract_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"},
    "frame_id": {"type": "string", "minLength": 8},
    "revision": {"type": "integer", "minimum": 1},
    "goal": {"type": "string", "enum": ["host_investigation"]},
    "entities": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["type", "value"], "additionalProperties": false,
        "properties": {
          "type": {"enum": ["host", "ip", "user", "process"]},
          "value": {"type": "string", "minLength": 1}
        }
      }
    },
    "constraints": {
      "type": "object", "required": ["time_window", "data_sources", "deadline_ms"], "additionalProperties": false,
      "properties": {
        "time_window": {
          "type": "object", "required": ["start", "end"], "additionalProperties": false,
          "properties": {"start": {"type": "integer", "minimum": 0}, "end": {"type": "integer", "minimum": 0}}
        },
        "data_sources": {"type": "array", "minItems": 1, "items": {"enum": ["siem", "edr"]}},
        "deadline_ms": {"type": "integer", "minimum": 1}
      }
    },
    "context_refs": {"type": "array", "items": {"type": "string"}},
    "target_confidence": {"type": "number", "minimum": 0, "maximum": 1}
  }
}
